# ==============================================================================
# ARQVERTICE STUDIO — AMBIENTE DE PRODUÇÃO (.env.production.example)
# ==============================================================================
# Todas as variáveis marcadas com ${...} devem ser injetadas pelo Kubernetes Secrets,
# AWS Secrets Manager, HashiCorp Vault ou GCP Secret Manager.

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# 1. BANCO DE DADOS (PostgreSQL HA / Managed Cluster)
DATABASE_URL=postgresql://arq_prod_app:${PROD_DB_PASSWORD}@prod-cluster.db.arqvertice.internal:5432/arqvertice_prod?sslmode=require
SQLITE_PATH=

# 2. ARMAZENAMENTO MULTI-TIER (S3 / Cloudflare R2 / GCS)
STORAGE_ROOT=/var/arqvertice/storage
S3_ENDPOINT=https://s3.arqvertice.com
S3_BUCKET_NAME=arqvertice-prod-assets-vault
S3_ACCESS_KEY_ID=${PROD_S3_KEY_ID}
S3_SECRET_ACCESS_KEY=${PROD_S3_SECRET_KEY}
S3_REGION=sa-east-1

# 3. SEGURANÇA E CORS ESTRITO
CORS_ALLOWED_ORIGINS=https://app.arqvertice.com,https://viewer.arqvertice.com,https://portal.arqvertice.com
JWT_SECRET=${PROD_JWT_SIGNING_SECRET_MIN_64_CHARS}
SESSION_SECRET=${PROD_SESSION_SECRET_MIN_64_CHARS}
COOKIE_SECURE=true

# 4. PROVIDERS DE INTELIGÊNCIA ARTIFICIAL (SECRETS PROTEGIDOS)
OLLAMA_HOST=http://ollama-service.ai-cluster.internal:11434
AI_GATEWAY_URL=https://api.omniroute.ai/v1
OPENAI_API_KEY=${PROD_OPENAI_API_KEY}
ANTHROPIC_API_KEY=${PROD_ANTHROPIC_API_KEY}
GEMINI_API_KEY=${PROD_GEMINI_API_KEY}

# 5. MCP E INTEGRAÇÃO
REVIT_MCP_PORT=48080
REVIT_SYNC_ENABLED=false
