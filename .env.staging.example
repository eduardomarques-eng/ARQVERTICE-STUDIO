# ==============================================================================
# ARQVERTICE STUDIO — AMBIENTE DE HOMOLOGAÇÃO / STAGING (.env.staging.example)
# ==============================================================================

NODE_ENV=staging
PORT=8080
HOST=0.0.0.0

DATABASE_URL=postgresql://arq_staging_user:${STAGING_DB_PASSWORD}@staging-db.arqvertice.internal:5432/arqvertice_staging
SQLITE_PATH=

STORAGE_ROOT=/var/arqvertice/storage
S3_ENDPOINT=https://s3.staging.arqvertice.com
S3_BUCKET_NAME=arqvertice-staging-assets
S3_ACCESS_KEY_ID=${STAGING_S3_KEY}
S3_SECRET_ACCESS_KEY=${STAGING_S3_SECRET}
S3_REGION=sa-east-1

CORS_ALLOWED_ORIGINS=https://staging.arqvertice.com,https://staging-viewer.arqvertice.com
JWT_SECRET=${STAGING_JWT_SECRET}
SESSION_SECRET=${STAGING_SESSION_SECRET}
COOKIE_SECURE=true

OLLAMA_HOST=http://ollama-staging.internal:11434
AI_GATEWAY_URL=https://api.omniroute.ai/v1
OPENAI_API_KEY=${STAGING_OPENAI_API_KEY}
ANTHROPIC_API_KEY=${STAGING_ANTHROPIC_API_KEY}
GEMINI_API_KEY=${STAGING_GEMINI_API_KEY}

REVIT_MCP_PORT=48080
REVIT_SYNC_ENABLED=false
