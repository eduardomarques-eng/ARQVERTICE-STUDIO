# ==============================================================================
# ARQVERTICE STUDIO — TEMPLATE GERAL DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env.development ou configure as variáveis no seu Vault/CI.
# NUNCA insira credenciais reais neste arquivo rastreado pelo Git.

# 1. AMBIENTE & REDE
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 2. BANCO DE DADOS & PERSISTÊNCIA
DATABASE_URL=sqlite://./database/arqvertice.db
SQLITE_PATH=./database/arqvertice.db

# 3. ARMAZENAMENTO DE ASSETS 3D (5-TIER STORAGE)
STORAGE_ROOT=./storage
S3_ENDPOINT=https://s3.arqvertice.com
S3_BUCKET_NAME=arqvertice-3d-assets
S3_ACCESS_KEY_ID=placeholder_s3_key
S3_SECRET_ACCESS_KEY=placeholder_s3_secret
S3_REGION=us-east-1

# 4. SEGURANÇA, SESSÃO & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
SESSION_SECRET=change_this_session_secret_at_least_32_chars
COOKIE_SECURE=false

# 5. INTELIGÊNCIA ARTIFICIAL & MODEL ROUTING (SERVER-ONLY)
OLLAMA_HOST=http://127.0.0.1:11434
AI_GATEWAY_URL=https://api.omniroute.ai/v1
OPENAI_API_KEY=sk-placeholder-openai-key
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
GEMINI_API_KEY=placeholder-gemini-key

# 6. INTEGRAÇÃO AUTODESK REVIT & MCP
REVIT_MCP_PORT=48080
REVIT_SYNC_ENABLED=true
