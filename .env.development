# ==============================================================================
# ARQVERTICE STUDIO — AMBIENTE DE DESENVOLVIMENTO LOCAL (.env.development)
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=sqlite://./database/arqvertice_dev.db
SQLITE_PATH=./database/arqvertice_dev.db

STORAGE_ROOT=./storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_NAME=arqvertice-dev-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
JWT_SECRET=arqvertice_dev_jwt_secret_key_32_characters_long_12345
SESSION_SECRET=arqvertice_dev_session_secret_32_characters_long_123
COOKIE_SECURE=false

OLLAMA_HOST=http://127.0.0.1:11434
AI_GATEWAY_URL=http://localhost:8080/v1
OPENAI_API_KEY=sk-dev-mock-key
ANTHROPIC_API_KEY=sk-ant-dev-mock-key
GEMINI_API_KEY=dev-mock-key

REVIT_MCP_PORT=48080
REVIT_SYNC_ENABLED=true
