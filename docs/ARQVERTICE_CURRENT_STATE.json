    { "endpoint": "/api/tarefas?id={UUID}", "method": "PUT", "authRequired": true, "description": "Atualiza campos parciais da etapa" },
    { "endpoint": "/api/tarefas?id={UUID}", "method": "DELETE", "authRequired": true, "description": "Remove etapa pelo identificador UUID" }
