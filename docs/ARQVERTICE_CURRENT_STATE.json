  "database": {
    "engine": "PostgreSQL",
    "managedProvidersTested": ["Neon", "Supabase", "AWS RDS"],
    "schemaScript": "database/schema.sql",
    "isIdempotent": true,
    "tables": [
      {
        "name": "projeto",
        "primaryKey": "id (SMALLINT)",
        "constraints": ["CHECK (id = 1)"],
        "criticalLimitation": "Singleton de obra única (impede cadastrar mais de um projeto)",
        "columns": [
          "id", "nome_obra", "cliente", "localizacao", "lote_quadra", "zona",
          "area_construida", "area_terreno", "tipologia", "data_inicio",
          "previsao_conclusao", "prazo_total", "empresa", "atualizado_em"
        ]
      },
      {
        "name": "tarefas",
        "primaryKey": "id (UUID)",
        "foreignKeys": [],
        "criticalLimitation": "Desacoplada de projeto (sem coluna projeto_id)",
        "columns": [
          "id", "descricao_etapa", "disciplina_projeto", "projetista",
          "data_conclusao", "porcentagem", "ordem", "status", "criado_em", "atualizado_em"
        ],
        "generatedColumns": {
          "status": "CASE WHEN porcentagem = 0 THEN 'Não Iniciado' WHEN porcentagem = 100 THEN 'Finalizado' ELSE 'Em Andamento' END STORED"
        },
        "indices": [
          "idx_tarefas_disciplina",
          "idx_tarefas_projetista",
          "idx_tarefas_data",
          "idx_tarefas_ordem"
        ]
      }
    ],
    "triggers": [
      { "name": "trg_tarefas_atualizado", "function": "toca_atualizado_em()", "event": "BEFORE UPDATE ON tarefas" },
      { "name": "trg_projeto_atualizado", "function": "toca_atualizado_em()", "event": "BEFORE UPDATE ON projeto" }
    ],
    "seedData": {
      "projectName": "Residência de Praia",
      "client": "Pedro",
      "totalTasks": 14,
      "disciplines": ["Arquitetura", "3D", "Estrutura", "Complementares", "Obras"]
    }
  },
  "apis": [
    { "endpoint": "/api/status", "method": "GET", "authRequired": false, "description": "Diagnóstico de infraestrutura e conexão com Postgres" },
    { "endpoint": "/api/projeto", "method": "GET", "authRequired": false, "description": "Lê ficha técnica da obra 1" },
    { "endpoint": "/api/projeto", "method": "PUT", "authRequired": true, "description": "Atualiza ficha técnica da obra 1" },
